# Copiez ce fichier vers .env (ne jamais commiter .env)
SPRING_PROFILES_ACTIVE=dev
APP_VERSION=1.0.0-dev
SERVER_PORT=8080

# Base de donnees PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=libraflow_dev
DB_USER=libraflow
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# Comptes de demonstration initiaux (optionnel)
APP_SEED_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_MEMBER_USERNAME=etudiant
APP_MEMBER_PASSWORD=CHANGE_ME_MEMBER_PASSWORD

# Environnement de test (CD)
LIBRAFLOW_IMAGE=ghcr.io/VOTRE_ORG/libraflow:latest
TEST_SERVER_PORT=8081
